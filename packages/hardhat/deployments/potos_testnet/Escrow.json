ateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"confirm\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"name\":\"createOrder\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"deposit\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"dispute\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"getOrder\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"buyer\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"enum Escrow.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"internalType\":\"struct Escrow.Order\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"orderCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"refund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"sellerWins\",\"type\":\"bool\"}],\"name\":\"resolve\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/Escrow.sol\":\"Escrow\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/Escrow.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\n// Escrow \\u9700\\u8981\\u8c03\\u7528 ERC20 \\u4ee3\\u5e01\\u5408\\u7ea6\\uff0c\\u56e0\\u6b64\\u53ea\\u58f0\\u660e\\u9700\\u8981\\u4f7f\\u7528\\u7684\\u51fd\\u6570\\ninterface IERC20 {\\n    function transfer(\\n        address to,\\n        uint256 value\\n    ) external returns (bool);\\n\\n    function transferFrom(\\n        address from,\\n        address to,\\n        uint256 value\\n    ) external returns (bool);\\n\\n    function balanceOf(\\n        address account\\n    ) external view returns (uint256);\\n}\\n\\ncontract Escrow {\\n    // \\u8ba2\\u5355\\u72b6\\u6001\\uff1a\\n    // Created\\uff1a\\u5df2\\u521b\\u5efa\\u4f46\\u672a\\u4ed8\\u6b3e\\n    // Paid\\uff1a\\u5df2\\u4ed8\\u6b3e\\uff0c\\u4ee3\\u5e01\\u5728 Escrow \\u5408\\u7ea6\\u4e2d\\n    // Completed\\uff1a\\u4ea4\\u6613\\u5b8c\\u6210\\uff0c\\u4ee3\\u5e01\\u5df2\\u7ed9\\u5356\\u5bb6\\n    // Refunded\\uff1a\\u5df2\\u9000\\u6b3e\\uff0c\\u4ee3\\u5e01\\u5df2\\u9000\\u56de\\u4e70\\u5bb6\\n    // Disputed\\uff1a\\u8ba2\\u5355\\u5b58\\u5728\\u4e89\\u8bae\\uff0c\\u7b49\\u5f85\\u4ef2\\u88c1\\n    enum Status {\\n        Created,\\n        Paid,\\n        Completed,\\n        Refunded,\\n        Disputed\\n    }\\n\\n    // \\u4e00\\u7b14\\u8ba2\\u5355\\u5305\\u542b\\u7684\\u4fe1\\u606f\\n    struct Order {\\n        address buyer;       // \\u4e70\\u5bb6\\n        address seller;      // \\u5356\\u5bb6\\n        address token;       // \\u7528\\u4e8e\\u4ea4\\u6613\\u7684 ERC20 \\u4ee3\\u5e01\\u5730\\u5740\\n        uint256 amount;      // \\u4ea4\\u6613\\u91d1\\u989d\\uff0c\\u4f7f\\u7528\\u6700\\u5c0f\\u5355\\u4f4d\\n        uint256 deadline;    // \\u622a\\u6b62\\u65f6\\u95f4\\uff0cUnix \\u65f6\\u95f4\\u6233\\n        Status status;       // \\u5f53\\u524d\\u8ba2\\u5355\\u72b6\\u6001\\n        string description;  // \\u8ba2\\u5355\\u63cf\\u8ff0\\n    }\\n\\n    // \\u4ef2\\u88c1\\u4eba\\u5730\\u5740\\n    address public arbiter;\\n\\n    // \\u5f53\\u524d\\u8ba2\\u5355\\u6570\\u91cf\\uff0c\\u540c\\u65f6\\u4e5f\\u662f\\u4e0b\\u4e00\\u4e2a\\u8ba2\\u5355\\u7684 id\\n    uint256 public orderCount;\\n\\n    // \\u6839\\u636e\\u8ba2\\u5355 id \\u4fdd\\u5b58\\u8ba2\\u5355\\n    mapping(uint256 => Order) private _orders;\\n\\n    // \\u8ba2\\u5355\\u76f8\\u5173\\u4e8b\\u4ef6\\n    event OrderCreated(\\n        uint256 indexed id,\\n        address indexed buyer,\\n        address indexed seller,\\n        address token,\\n        uint256 amount,\\n        uint256 deadline\\n    );\\n\\n    event OrderPaid(uint256 indexed id);\\n    event OrderCompleted(uint256 indexed id);\\n    event OrderRefunded(uint256 indexed id);\\n    event OrderDisputed(uint256 indexed id, address by);\\n    event OrderResolved(uint256 indexed id, bool sellerWins);\\n\\n    // \\u53ea\\u6709\\u4ef2\\u88c1\\u4eba\\u53ef\\u4ee5\\u8c03\\u7528\\n    modifier onlyArbiter() {\\n        require(\\n            msg.sender == arbiter,\\n            \\\"Escrow: caller is not the arbiter\\\"\\n        );\\n        _;\\n    }\\n\\n    // \\u53ea\\u6709\\u8ba2\\u5355\\u4e70\\u5bb6\\u53ef\\u4ee5\\u8c03\\u7528\\n    modifier onlyBuyer(uint256 id) {\\n        require(\\n            msg.sender == _orders[id].buyer,\\n            \\\"Escrow: caller is not the buyer\\\"\\n        );\\n        _;\\n    }\\n\\n    // \\u9650\\u5236\\u8ba2\\u5355\\u5fc5\\u987b\\u5904\\u4e8e\\u6307\\u5b9a\\u72b6\\u6001\\n    modifier inStatus(uint256 id, Status s) {\\n        require(\\n            _orders[id].status == s,\\n            \\\"Escrow: wrong status\\\"\\n        );\\n        _;\\n    }\\n\\n    // \\u90e8\\u7f72\\u65f6\\u6307\\u5b9a\\u4ef2\\u88c1\\u4eba\\n    constructor(address _arbiter) {\\n        require(\\n            _arbiter != address(0),\\n            \\\"Escrow: arbiter is the zero address\\\"\\n        );\\n\\n        arbiter = _arbiter;\\n    }\\n\\n    // \\u67e5\\u8be2\\u8ba2\\u5355\\u4fe1\\u606f\\n    function getOrder(\\n        uint256 id\\n    ) public view returns (Order memory) {\\n        require(\\n            id < orderCount,\\n            \\\"Escrow: order does not exist\\\"\\n        );\\n\\n        return _orders[id];\\n    }\\n\\n    // TODO 1\\uff1a\\u521b\\u5efa\\u8ba2\\u5355\\n    function createOrder(\\n        address seller,\\n        address token,\\n        uint256 amount,\\n        uint256 deadline,\\n        string memory description\\n    ) public returns (uint256) {\\n        // \\u5356\\u5bb6\\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\n        require(\\n            seller != address(0),\\n            \\\"Escrow: seller is the zero address\\\"\\n        );\\n\\n        // \\u4e70\\u5bb6\\u4e0d\\u80fd\\u540c\\u65f6\\u662f\\u5356\\u5bb6\\n        require(\\n            seller != msg.sender,\\n            \\\"Escrow: buyer cannot be seller\\\"\\n        );\\n\\n        // \\u4ee3\\u5e01\\u5730\\u5740\\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\n        require(\\n            token != address(0),\\n            \\\"Escrow: token is the zero address\\\"\\n        );\\n\\n        // \\u4ea4\\u6613\\u91d1\\u989d\\u5fc5\\u987b\\u5927\\u4e8e\\u96f6\\n        require(\\n            amount > 0,\\n            \\\"Escrow: amount is zero\\\"\\n        );\\n\\n        // \\u622a\\u6b62\\u65f6\\u95f4\\u5fc5\\u987b\\u665a\\u4e8e\\u5f53\\u524d\\u533a\\u5757\\u65f6\\u95f4\\n        require(\\n            deadline > block.timestamp,\\n            \\\"Escrow: deadline in the past\\\"\\n        );\\n\\n        // \\u5f53\\u524d\\u8ba2\\u5355\\u6570\\u91cf\\u5c31\\u662f\\u65b0\\u8ba2\\u5355\\u7684 id\\n        uint256 id = orderCount;\\n\\n        // \\u5199\\u5165\\u8ba2\\u5355\\u4fe1\\u606f\\uff0c\\u521b\\u5efa\\u65f6\\u72b6\\u6001\\u4e3a Created\\n        _orders[id] = Order({\\n            buyer: msg.sender,\\n            seller: seller,\\n            token: token,\\n            amount: amount,\\n            deadline: deadline,\\n            status: Status.Created,\\n            description: description\\n        });\\n\\n        // \\u8ba2\\u5355\\u6570\\u91cf\\u52a0\\u4e00\\n        orderCount += 1;\\n\\n        // \\u53d1\\u51fa\\u8ba2\\u5355\\u521b\\u5efa\\u4e8b\\u4ef6\\n        emit OrderCreated(\\n            id,\\n            msg.sender,\\n            seller,\\n            token,\\n            amount,\\n            deadline\\n        );\\n\\n        return id;\\n    }\\n\\n    // TODO 2\\uff1a\\u4e70\\u5bb6\\u4ed8\\u6b3e\\n    function deposit(\\n        uint256 id\\n    )\\n        public\\n        onlyBuyer(id)\\n        inStatus(id, Status.Created)\\n    {\\n        Order storage o = _orders[id];\\n\\n        // \\u5148\\u4fee\\u6539\\u72b6\\u6001\\uff0c\\u518d\\u8c03\\u7528\\u5916\\u90e8\\u4ee3\\u5e01\\u5408\\u7ea6\\n        o.status = Status.Paid;\\n\\n        // Escrow \\u8c03\\u7528\\u4ee3\\u5e01\\u5408\\u7ea6\\u7684 transferFrom\\n        // \\u56e0\\u6b64\\u4ee3\\u5e01\\u5408\\u7ea6\\u770b\\u5230\\u7684 msg.sender \\u662f Escrow \\u5408\\u7ea6\\n        bool success = IERC20(o.token).transferFrom(\\n            msg.sender,\\n            address(this),\\n            o.amount\\n        );\\n\\n        require(\\n            success,\\n            \\\"Escrow: transferFrom failed\\\"\\n        );\\n\\n        emit OrderPaid(id);\\n    }\\n\\n    // TODO 3\\uff1a\\u4e70\\u5bb6\\u786e\\u8ba4\\u6536\\u8d27\\n    function confirm(\\n        uint256 id\\n    )\\n        public\\n        onlyBuyer(id)\\n        inStatus(id, Status.Paid)\\n    {\\n        Order storage o = _orders[id];\\n\\n        // \\u5148\\u4fee\\u6539\\u72b6\\u6001\\n        o.status = Status.Completed;\\n\\n        // \\u5c06\\u4ee3\\u5e01\\u4ece Escrow \\u5408\\u7ea6\\u8f6c\\u7ed9\\u5356\\u5bb6\\n        bool success = IERC20(o.token).transfer(\\n            o.seller,\\n            o.amount\\n        );\\n\\n        require(\\n            success,\\n            \\\"Escrow: transfer failed\\\"\\n        );\\n\\n        emit OrderCompleted(id);\\n    }\\n\\n    // TODO 4\\uff1a\\u8d85\\u671f\\u9000\\u6b3e\\n    function refund(\\n        uint256 id\\n    )\\n        public\\n        onlyBuyer(id)\\n        inStatus(id, Status.Paid)\\n    {\\n        Order storage o = _orders[id];\\n\\n        // \\u5f53\\u524d\\u65f6\\u95f4\\u5fc5\\u987b\\u5df2\\u7ecf\\u8d85\\u8fc7\\u622a\\u6b62\\u65f6\\u95f4\\n        require(\\n            block.timestamp > o.deadline,\\n            \\\"Escrow: deadline not reached\\\"\\n        );\\n\\n        // \\u5148\\u4fee\\u6539\\u72b6\\u6001\\n        o.status = Status.Refunded;\\n\\n        // \\u5c06\\u4ee3\\u5e01\\u9000\\u56de\\u4e70\\u5bb6\\n        bool success = IERC20(o.token).transfer(\\n            o.buyer,\\n            o.amount\\n        );\\n\\n        require(\\n            success,\\n            \\\"Escrow: transfer failed\\\"\\n        );\\n\\n        emit OrderRefunded(id);\\n    }\\n\\n    // TODO 5\\uff1a\\u53d1\\u8d77\\u4e89\\u8bae\\n    function dispute(\\n        uint256 id\\n    )\\n        public\\n        inStatus(id, Status.Paid)\\n    {\\n        Order storage o = _orders[id];\\n\\n        // \\u53ea\\u6709\\u4e70\\u5bb6\\u6216\\u5356\\u5bb6\\u53ef\\u4ee5\\u53d1\\u8d77\\u4e89\\u8bae\\n        require(\\n            msg.sender == o.buyer ||\\n            msg.sender == o.seller,\\n            \\\"Escrow: caller is not a party\\\"\\n        );\\n\\n        // \\u5c06\\u8ba2\\u5355\\u72b6\\u6001\\u6539\\u4e3a Disputed\\n        o.status = Status.Disputed;\\n\\n        emit OrderDisputed(id, msg.sender);\\n    }\\n\\n    // TODO 6\\uff1a\\u4ef2\\u88c1\\n    function resolve(\\n        uint256 id,\\n        bool sellerWins\\n    )\\n        public\\n        onlyArbiter\\n        inStatus(id, Status.Disputed)\\n    {\\n        Order storage o = _orders[id];\\n\\n        if (sellerWins) {\\n            // \\u4ef2\\u88c1\\u7ed3\\u679c\\uff1a\\u5356\\u5bb6\\u80dc\\u8bc9\\n            o.status = Status.Completed;\\n\\n            bool successSeller = IERC20(o.token).transfer(\\n                o.seller,\\n                o.amount\\n            );\\n\\n            require(\\n                successSeller,\\n                \\\"Escrow: transfer failed\\\"\\n            );\\n        } else {\\n            // \\u4ef2\\u88c1\\u7ed3\\u679c\\uff1a\\u4e70\\u5bb6\\u80dc\\u8bc9\\uff0c\\u9000\\u6b3e\\u7ed9\\u4e70\\u5bb6\\n            o.status = Status.Refunded;\\n\\n            bool successBuyer = IERC20(o.token).transfer(\\n                o.buyer,\\n                o.amount\\n            );\\n\\n            require(\\n                successBuyer,\\n                \\\"Escrow: transfer failed\\\"\\n            );\\n        }\\n\\n        emit OrderResolved(id, sellerWins);\\n    }\\n}\",\"keccak256\":\"0xc5b06cf925b6028aac1c9a82dae614531802cd394b75f12184e95d7671aa82ad\",\"license\":\"MIT\"}},\"version\":1}",
